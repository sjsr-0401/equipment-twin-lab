<Window x:Class="EquipmentTwin.Hmi.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Equipment Twin Lab - WPF Operator Console"
        Width="1380"
        Height="820"
        MinWidth="1180"
        MinHeight="720"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{Binding PageBackground}"
        FontFamily="Segoe UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Icon>
        <DrawingImage>
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#0B0F14">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,32,32" RadiusX="6" RadiusY="6"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#173E5A">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="3,3,26,26" RadiusX="5" RadiusY="5"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#2EA8FF">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="8,8,3,16"/>
                                <RectangleGeometry Rect="8,8,12,3"/>
                                <RectangleGeometry Rect="8,14.5,10,3"/>
                                <RectangleGeometry Rect="8,21,12,3"/>
                                <RectangleGeometry Rect="22,8,3,16"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
    </Window.Icon>

    <Window.Resources>
        <SolidColorBrush x:Key="Background" Color="#0B0F14"/>
        <SolidColorBrush x:Key="Surface" Color="#151C24"/>
        <SolidColorBrush x:Key="SurfaceRaised" Color="#1D2733"/>
        <SolidColorBrush x:Key="SurfaceInset" Color="#0F151B"/>
        <SolidColorBrush x:Key="Border" Color="#2F3C4C"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#233142"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#EAF0F7"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9AA8B7"/>
        <SolidColorBrush x:Key="Primary" Color="#2EA8FF"/>
        <SolidColorBrush x:Key="PrimaryDim" Color="#173E5A"/>
        <SolidColorBrush x:Key="Success" Color="#2AD17D"/>
        <SolidColorBrush x:Key="Warning" Color="#FFB84D"/>
        <SolidColorBrush x:Key="Alarm" Color="#FF3B3B"/>
        <SolidColorBrush x:Key="Precursor" Color="#F7A83B"/>
        <SolidColorBrush x:Key="Reactant" Color="#38CFFF"/>
        <SolidColorBrush x:Key="Purge" Color="#31D86B"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="8"/>
        </Style>

        <Style x:Key="CommandButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseTitleBarButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Alarm}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Foreground" Value="{StaticResource Primary}"/>
            <Setter Property="Background" Value="#0F151B"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="ComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Border"
                                Background="{StaticResource SurfaceInset}"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="34"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  Margin="10,0,0,0"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                                <Path Grid.Column="1"
                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                      Fill="{StaticResource TextMuted}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource Primary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceInset}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Style="{StaticResource ComboBoxToggleButton}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Foreground="{TemplateBinding Foreground}"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Slide">
                                <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="{StaticResource SurfaceRaised}"
                                            BorderBrush="{StaticResource Border}"
                                            BorderThickness="1"/>
                                    <ScrollViewer Margin="0"
                                                  SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryDim}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryDim}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0"
                                      IsItemsHost="True"
                                      Margin="0,0,0,10"/>
                            <Border Grid.Row="1"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceInset}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Primary}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PrimaryDim}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Primary}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="#111820"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#182536"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryDim}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryDim}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource SurfaceInset}"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Border Width="26"
                            Height="26"
                            CornerRadius="6"
                            Background="{StaticResource PrimaryDim}"
                            BorderBrush="{StaticResource Primary}"
                            BorderThickness="1">
                        <TextBlock Text="ET"
                                   Foreground="{StaticResource Primary}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Equipment Twin Lab"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="13"
                                   FontWeight="Bold"/>
                        <TextBlock Text="WPF Operator Console"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="10"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Width="8"
                            Height="8"
                            CornerRadius="4"
                            Background="{StaticResource Primary}"
                            Margin="0,0,8,0"/>
                    <TextBlock Text="SYNTHETIC MOLY ALD HMI"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="_"
                            Click="MinimizeButton_Click"
                            Style="{StaticResource TitleBarButton}"/>
                    <Button Content="[]"
                            Click="MaximizeRestoreButton_Click"
                            Style="{StaticResource TitleBarButton}"/>
                    <Button Content="X"
                            Click="CloseButton_Click"
                            Style="{StaticResource CloseTitleBarButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18,12,18,18">
            <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="220"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.55*"/>
            <ColumnDefinition Width="0.95*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,28,0">
                <TextBlock Text="{Binding Title}"
                           FontSize="28"
                           FontWeight="Bold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Subtitle}"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding LanguageToggleText}"
                        Command="{Binding ToggleLanguageCommand}"
                        Style="{StaticResource CommandButton}"
                        Width="88"
                        Height="44"
                        Margin="0,0,8,0"
                        FontSize="13"/>
                <Border MinWidth="330"
                        Padding="18,8"
                        Background="{StaticResource SurfaceRaised}"
                        CornerRadius="8">
                    <TextBlock Text="{Binding RunStateText}"
                               Foreground="{Binding RunStateBrush}"
                               FontSize="16"
                               FontWeight="Bold"
                               TextAlignment="Center"/>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,32,0">
                        <TextBlock Text="{Binding SchematicTitle}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SchematicSubtitle}"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding TimelineSource}"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="360"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,18,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="210"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="118"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="82"/>
                    </Grid.RowDefinitions>

                    <Border Grid.ColumnSpan="3"
                            Grid.RowSpan="2"
                            Background="{StaticResource SurfaceInset}"
                            BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14"/>

                    <TextBlock Grid.ColumnSpan="3"
                               Text="EQUIPMENT MODULE LAYOUT"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="18,10,0,0"/>

                    <Border Grid.Column="0"
                            Grid.Row="1"
                            Width="122"
                            Height="148"
                            Background="{StaticResource SurfaceRaised}"
                            BorderBrush="{StaticResource Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="LOAD PORT"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                            <Border Grid.Row="1"
                                    Background="{StaticResource Background}"
                                    BorderBrush="{StaticResource BorderSoft}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Margin="0,10">
                                <StackPanel VerticalAlignment="Center" Margin="10">
                                    <Rectangle Height="10" Fill="{StaticResource Border}" Margin="0,0,0,8"/>
                                    <Rectangle Height="10" Fill="{StaticResource Border}" Margin="0,0,0,8"/>
                                    <Rectangle Height="10" Fill="{StaticResource Border}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Grid.Row="2"
                                       Text="FOUP / WAFER IN"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Rectangle Grid.Column="0"
                               Grid.Row="1"
                               Height="8"
                               Fill="{StaticResource Border}"
                               HorizontalAlignment="Right"
                               Width="62"
                               Margin="0,0,-20,0"/>

                    <Border Grid.Column="1"
                            Grid.Row="0"
                            Background="{StaticResource Surface}"
                            BorderBrush="{StaticResource Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="18,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="16"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="GAS BOX / DELIVERY MANIFOLD"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="11"
                                       FontWeight="Bold"/>
                            <UniformGrid Grid.Row="1" Columns="3" Margin="0,10,0,0">
                                <StackPanel Margin="6,0">
                                    <TextBlock Text="PRECURSOR" Foreground="{StaticResource TextMuted}" FontSize="10" HorizontalAlignment="Center"/>
                                    <Border Height="38" Background="{Binding PrecursorValveBrush}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding PrecursorValveText}" FontSize="10" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" LineHeight="12"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Margin="6,0">
                                    <TextBlock Text="REACTANT" Foreground="{StaticResource Reactant}" FontSize="10" HorizontalAlignment="Center"/>
                                    <Border Height="38" Background="{Binding ReactantValveBrush}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding ReactantValveText}" FontSize="10" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" LineHeight="12"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Margin="6,0">
                                    <TextBlock Text="PURGE N2" Foreground="{StaticResource TextMuted}" FontSize="10" HorizontalAlignment="Center"/>
                                    <Border Height="38" Background="{Binding PurgeValveBrush}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding PurgeValveText}" FontSize="10" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" LineHeight="12"/>
                                    </Border>
                                </StackPanel>
                            </UniformGrid>
                            <Grid Grid.Row="2" Margin="32,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" Width="3" Fill="{StaticResource Precursor}" HorizontalAlignment="Center"/>
                                <Rectangle Grid.Column="1" Width="3" Fill="{StaticResource Reactant}" HorizontalAlignment="Center"/>
                                <Rectangle Grid.Column="2" Width="3" Fill="{StaticResource Purge}" HorizontalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Rectangle Grid.Column="1"
                               Grid.Row="1"
                               Width="3"
                               Fill="{Binding FlowBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Height="32"
                               Opacity="0.9"/>

                    <Border Grid.Column="1"
                            Grid.Row="1"
                            Background="{Binding ChamberBrush}"
                            BorderBrush="{Binding FlowBrush}"
                            BorderThickness="2"
                            CornerRadius="12"
                            Padding="18"
                            Margin="18,24,18,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="PROCESS CHAMBER"
                                           Foreground="{StaticResource TextMuted}"
                                           FontWeight="Bold"/>
                                <Border Grid.Column="1"
                                        Background="{StaticResource SurfaceInset}"
                                        BorderBrush="{Binding FlowBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8,2">
                                    <TextBlock Text="VACUUM"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="10"
                                               FontWeight="Bold"/>
                                </Border>
                            </Grid>
                            <Grid Grid.Row="1" Margin="20,18">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="42"/>
                                </Grid.RowDefinitions>
                                <Rectangle Grid.Row="0"
                                           Height="12"
                                           Fill="#A9B3BE"
                                           RadiusX="2"
                                           RadiusY="2"
                                           VerticalAlignment="Center"
                                           Margin="36,0"/>
                                <TextBlock Grid.Row="0"
                                           Text="showerhead"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="10"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Bottom"/>
                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    <Rectangle Height="12" Fill="{StaticResource Primary}" Margin="82,0,82,0"/>
                                    <Rectangle Height="16" Fill="{StaticResource Warning}" Margin="72,0,72,0"/>
                                    <TextBlock Text="wafer + film / susceptor heater"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               Margin="0,8,0,0"/>
