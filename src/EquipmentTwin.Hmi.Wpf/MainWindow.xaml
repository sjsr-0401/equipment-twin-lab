                                                    Style="{StaticResource CommandButton}"
                                                    Height="34"
                                                    Margin="0,3"
                                                    Padding="8,4"
                                                    ToolTip="{Binding NextAction}">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding EscalationText}" Foreground="{StaticResource Warning}" FontSize="10" FontWeight="Bold" Margin="8,0,0,0"/>
                                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="12"/>
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Background="{StaticResource SurfaceInset}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedAlarmGuideChoiceText}" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <Button Content="{Binding ExportIssueReportButtonText}"
                                                Command="{Binding ExportIssueReportCommand}"
                                                Style="{StaticResource CommandButton}"
                                                Height="32"
                                                Margin="0,6,0,0"
                                                FontSize="11"
                                                Background="{StaticResource PrimaryDim}"/>
                                        <TextBlock Text="{Binding IssueReportStatus}" Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        <Button Content="{Binding QueueReportButtonText}"
                                                Command="{Binding QueueIssueReportCommand}"
                                                Style="{StaticResource CommandButton}"
                                                Height="32"
                                                Margin="0,8,0,0"
                                                FontSize="11"
                                                Background="{StaticResource SurfaceRaised}"/>
                                        <TextBlock Text="{Binding ServerOutboxStatus}" Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>

                                        <Border Background="{StaticResource Background}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,8,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding LatestIssueReportLabel}" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding LatestIssueReportPathText}"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           FontFamily="Consolas"
                                                           FontSize="10"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding LatestIssueReportPathText}"
                                                           Margin="0,4,0,0"/>
                                                <UniformGrid Columns="2" Margin="0,6,0,0">
                                                    <Button Content="{Binding OpenReportFolderButtonText}"
                                                            Command="{Binding OpenReportFolderCommand}"
                                                            Style="{StaticResource CommandButton}"
                                                            Height="30"
                                                            Margin="0,0,4,0"
                                                            FontSize="10"
                                                            Background="{StaticResource SurfaceRaised}"/>
                                                    <Button Content="{Binding OpenLatestReportButtonText}"
                                                            Command="{Binding OpenLatestReportCommand}"
                                                            Style="{StaticResource CommandButton}"
                                                            Height="30"
                                                            Margin="4,0,0,0"
                                                            FontSize="10"
                                                            Background="{StaticResource SurfaceRaised}"/>
                                                </UniformGrid>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{StaticResource Background}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,8,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding LatestServerPayloadLabel}" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding LatestServerPayloadPathText}"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           FontFamily="Consolas"
                                                           FontSize="10"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding LatestServerPayloadPathText}"
                                                           Margin="0,4,0,0"/>
                                                <Border Background="{StaticResource SurfaceInset}"
                                                        BorderBrush="{Binding MockServerHealthBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="8"
                                                        Margin="0,8,0,0">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Grid.ColumnSpan="2">
                                                            <TextBlock Text="{Binding MockServerConnectionLabel}"
                                                                       Foreground="{StaticResource TextMuted}"
                                                                       FontSize="10"
                                                                       FontWeight="Bold"/>
                                                            <TextBlock Text="{Binding MockServerHealthBadgeText}"
                                                                       Foreground="{Binding MockServerHealthBrush}"
                                                                       FontSize="12"
                                                                       FontWeight="Bold"
                                                                       Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="2"
                                                                Content="{Binding CheckMockServerHealthButtonText}"
                                                                Command="{Binding CheckMockServerHealthCommand}"
                                                                Style="{StaticResource CommandButton}"
                                                                MinWidth="96"
                                                                Height="30"
                                                                Margin="8,0,0,0"
                                                                FontSize="10"
                                                                Background="{StaticResource SurfaceRaised}"/>
                                                        <TextBlock Grid.Row="1"
                                                                   Grid.Column="0"
                                                                   Grid.ColumnSpan="3"
                                                                   Text="{Binding MockServerHealthStatusText}"
                                                                   Foreground="{StaticResource TextMuted}"
                                                                   FontSize="10"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,6,0,0"/>
                                                    </Grid>
                                                </Border>
                                                <UniformGrid Columns="2" Margin="0,6,0,0">
                                                    <Button Content="{Binding OpenServerOutboxFolderButtonText}"
                                                            Command="{Binding OpenServerOutboxFolderCommand}"
                                                            Style="{StaticResource CommandButton}"
                                                            Height="30"
                                                            Margin="0,0,4,0"
                                                            FontSize="10"
                                                            Background="{StaticResource SurfaceRaised}"/>
                                                    <Button Content="{Binding OpenLatestServerPayloadButtonText}"
                                                            Command="{Binding OpenLatestServerPayloadCommand}"
                                                            Style="{StaticResource CommandButton}"
                                                            Height="30"
                                                            Margin="4,0,0,0"
                                                            FontSize="10"
                                                            Background="{StaticResource SurfaceRaised}"/>
                                                </UniformGrid>
                                                <Button Content="{Binding SendLatestServerPayloadButtonText}"
                                                        Command="{Binding SendLatestServerPayloadCommand}"
                                                        Style="{StaticResource CommandButton}"
                                                        Height="32"
                                                        Margin="0,8,0,0"
                                                        FontSize="10"
                                                        Background="{StaticResource PrimaryDim}"/>
                                                <TextBlock Text="{Binding LatestMockServerSendStatus}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding ServerPayloadPreviewLabel}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Margin="0,8,0,4"/>
                                                <TextBox Text="{Binding LatestServerPayloadPreviewText, Mode=OneWay}"
                                                         IsReadOnly="True"
                                                         Height="92"
                                                         Background="{StaticResource SurfaceInset}"
                                                         Foreground="{StaticResource TextPrimary}"
                                                         BorderBrush="{StaticResource BorderSoft}"
                                                         BorderThickness="1"
                                                         FontFamily="Consolas"
                                                         FontSize="10"
                                                         TextWrapping="NoWrap"
                                                         HorizontalScrollBarVisibility="Auto"
                                                         VerticalScrollBarVisibility="Auto"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Binding EscalationConditionsLabel}" Foreground="{StaticResource TextMuted}" FontWeight="Bold" FontSize="11" Margin="0,10,0,4"/>
                                <ItemsControl ItemsSource="{Binding AlarmGuideEscalationConditions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="{StaticResource TextPrimary}" FontSize="11" TextWrapping="Wrap" Margin="0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>

                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{Binding OperatorLogTabHeader}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                <Border Background="{StaticResource Surface}" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="{Binding OperatorActionLogLabel}" Foreground="{StaticResource TextMuted}" FontWeight="Bold" FontSize="12"/>
                        <ItemsControl ItemsSource="{Binding OperatorLog}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Foreground="{StaticResource TextMuted}" Width="58" FontSize="12"/>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Action}" Foreground="{StaticResource TextPrimary}" Width="108" FontSize="12" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextPrimary}" FontSize="12"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{Binding OpenUnityViewerButtonText}"
                                Command="{Binding OpenUnityViewerCommand}"
                                Style="{StaticResource CommandButton}"
                                Margin="0,10,0,0"
                                Height="34"
                                FontSize="12"/>
                    </StackPanel>
                </Border>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*"/>
                    <ColumnDefinition Width="0.9*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding TimelineDebugTableLabel}" Foreground="{StaticResource TextMuted}" FontWeight="Bold" FontSize="13"/>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Steps}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              Background="{StaticResource Surface}"
                              Foreground="{StaticResource TextPrimary}"
                              RowBackground="#111820"
                              AlternatingRowBackground="#0F151B"
                              HorizontalGridLinesBrush="{StaticResource BorderSoft}"
                              VerticalGridLinesBrush="{StaticResource BorderSoft}"
                              GridLinesVisibility="All"
                              BorderBrush="{StaticResource Border}"
                              BorderThickness="1"
                              RowHeight="25"
                              ColumnHeaderHeight="30"
                              Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="45"/>
                            <DataGridTextColumn Header="Step" Binding="{Binding Step}" Width="150"/>
                            <DataGridTextColumn Header="Cycle" Binding="{Binding Cycle}" Width="60"/>
                            <DataGridTextColumn Header="Pressure" Binding="{Binding Pressure}" Width="100"/>
                            <DataGridTextColumn Header="Temp" Binding="{Binding Temperature}" Width="70"/>
                            <DataGridTextColumn Header="Film" Binding="{Binding Film}" Width="70"/>
                            <DataGridTextColumn Header="Valve" Binding="{Binding Valve}" Width="90"/>
                            <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="70"/>
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Border Grid.Column="1" Background="{StaticResource SurfaceInset}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="8,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding EngineeringTraceConsoleLabel}" Foreground="{StaticResource TextMuted}" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Grid.Column="1" Text="{Binding EngineeringTraceStatus}" Foreground="{StaticResource TextMuted}" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <ItemsControl ItemsSource="{Binding EngineeringTrace}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="86"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" Foreground="{StaticResource TextMuted}" FontFamily="Consolas" FontSize="11"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Source}" Foreground="{StaticResource Warning}" FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="{StaticResource TextPrimary}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Window>
