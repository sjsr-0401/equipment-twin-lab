<Window x:Class="EquipmentTwin.Hmi.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Equipment Twin Lab - WPF Operator Console"
        Width="1380"
        Height="820"
        MinWidth="1180"
        MinHeight="720"
        Background="{Binding PageBackground}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Background" Color="#0B0F14"/>
        <SolidColorBrush x:Key="Surface" Color="#151C24"/>
        <SolidColorBrush x:Key="SurfaceRaised" Color="#1D2733"/>
        <SolidColorBrush x:Key="SurfaceInset" Color="#0F151B"/>
        <SolidColorBrush x:Key="Border" Color="#2F3C4C"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#233142"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#EAF0F7"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9AA8B7"/>
        <SolidColorBrush x:Key="Primary" Color="#2EA8FF"/>
        <SolidColorBrush x:Key="PrimaryDim" Color="#173E5A"/>
        <SolidColorBrush x:Key="Success" Color="#2AD17D"/>
        <SolidColorBrush x:Key="Warning" Color="#FFB84D"/>
        <SolidColorBrush x:Key="Alarm" Color="#FF3B3B"/>
        <SolidColorBrush x:Key="Precursor" Color="#F7A83B"/>
        <SolidColorBrush x:Key="Reactant" Color="#38CFFF"/>
        <SolidColorBrush x:Key="Purge" Color="#31D86B"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="8"/>
        </Style>

        <Style x:Key="CommandButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Foreground" Value="{StaticResource Primary}"/>
            <Setter Property="Background" Value="#0F151B"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceInset}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryDim}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryDim}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="#111820"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#182536"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryDim}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryDim}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="176"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.55*"/>
            <ColumnDefinition Width="0.95*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="8,0,8,8">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextMuted}" FontSize="13"/>
            </StackPanel>
            <Border DockPanel.Dock="Right"
                    MinWidth="330"
                    Padding="18,8"
                    Background="{StaticResource SurfaceRaised}"
                    CornerRadius="8">
                <TextBlock Text="{Binding RunStateText}"
                           Foreground="{Binding RunStateBrush}"
                           FontSize="16"
                           FontWeight="Bold"
                           TextAlignment="Center"/>
            </Border>
        </DockPanel>

        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel>
                    <StackPanel>
                        <TextBlock Text="Synthetic Moly ALD — Process Schematic" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="public-reference HMI | not vendor CAD or process copy" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding TimelineSource}"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <Grid Grid.Row="1" Margin="0,18,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="110"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="82"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Column="0" Grid.Row="1" Width="104" Height="118" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6">
                        <StackPanel VerticalAlignment="Center" Margin="12">
                            <Rectangle Height="14" Fill="{StaticResource Background}" Margin="0,0,0,10"/>
                            <Rectangle Height="14" Fill="{StaticResource Background}"/>
                            <TextBlock Text="LOAD PORT" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <StackPanel Margin="18,0">
                            <TextBlock Text="PRECURSOR" Foreground="{StaticResource TextMuted}" FontSize="11" HorizontalAlignment="Center"/>
                            <Border Width="58" Height="38" Background="{Binding PrecursorValveBrush}" CornerRadius="4" Margin="0,8,0,0">
                                <TextBlock Text="{Binding PrecursorValveText}" FontSize="10" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Margin="18,0">
                            <TextBlock Text="REACTANT" Foreground="{StaticResource Reactant}" FontSize="11" HorizontalAlignment="Center"/>
                            <Border Width="58" Height="38" Background="{Binding ReactantValveBrush}" CornerRadius="4" Margin="0,8,0,0">
                                <TextBlock Text="{Binding ReactantValveText}" FontSize="10" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Margin="18,0">
                            <TextBlock Text="PURGE N2" Foreground="{StaticResource TextMuted}" FontSize="11" HorizontalAlignment="Center"/>
                            <Border Width="58" Height="38" Background="{Binding PurgeValveBrush}" CornerRadius="4" Margin="0,8,0,0">
                                <TextBlock Text="{Binding PurgeValveText}" FontSize="10" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Grid.Row="1" Background="{Binding ChamberBrush}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="VACUUM CHAMBER" Foreground="{StaticResource TextMuted}" FontWeight="Bold"/>
                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <Rectangle Height="14" Fill="#A9B3BE" Margin="60,0,60,24"/>
                                <TextBlock Text="showerhead" Foreground="{StaticResource TextPrimary}" FontSize="10" HorizontalAlignment="Center" Margin="0,-20,0,24"/>
                                <Rectangle Height="16" Fill="{StaticResource Primary}" Margin="80,0,80,0"/>
                                <Rectangle Height="18" Fill="{StaticResource Warning}" Margin="70,0,70,0"/>
                                <TextBlock Text="wafer + film / susceptor heater" Foreground="{StaticResource TextPrimary}" FontSize="10" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Row="2" Text="{Binding FlowText}" Foreground="{Binding FlowBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2" Grid.Row="1" VerticalAlignment="Center">
                        <Rectangle Height="8" Fill="{StaticResource TextMuted}" Margin="0,0,54,0"/>
                        <Border Width="90" Height="48" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <TextBlock Text="PUMP" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentStepName}" FontSize="24" FontWeight="Bold" TextAlignment="Center"/>
                        <TextBlock Text="{Binding RecipeCycleText}" Foreground="{StaticResource TextMuted}" FontSize="13" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="PROCESS TIMELINE" Foreground="{StaticResource TextMuted}" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="{Binding TimelineProgress, StringFormat={}{0:0}%}" Foreground="{StaticResource TextMuted}" Margin="12,0,0,0"/>
                    </Grid>
                    <ProgressBar Value="{Binding TimelineProgress, Mode=OneWay}" Maximum="100" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" Columns="5" Margin="0,0,0,10">
                    <Button Content="START" Command="{Binding StartCommand}" Style="{StaticResource CommandButton}" Background="{StaticResource Success}" Foreground="{StaticResource Background}"/>
                    <Button Content="STOP" Command="{Binding PauseCommand}" Style="{StaticResource CommandButton}" Background="#A82D2D"/>
                    <Button Content="STEP" Command="{Binding StepForwardCommand}" Style="{StaticResource CommandButton}"/>
                    <Button Content="FAULT REPLAY" Command="{Binding FaultReplayCommand}" Style="{StaticResource CommandButton}" Background="{StaticResource Warning}" Foreground="{StaticResource Background}"/>
                    <Button Content="RESET" Command="{Binding ResetCommand}" Style="{StaticResource CommandButton}"/>
                </UniformGrid>

                <Border Grid.Row="1" Background="{StaticResource SurfaceRaised}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="FAULT SCENARIO SELECTOR" Foreground="{StaticResource TextMuted}" FontWeight="Bold" FontSize="12"/>
                        <ComboBox ItemsSource="{Binding FaultScenarios}"
                                  SelectedItem="{Binding SelectedFaultScenario, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,8,0,6"
                                  FontSize="14"/>
                        <TextBlock Text="{Binding SelectorStatus}" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Background="{StaticResource SurfaceRaised}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CURRENT STEP" Foreground="{StaticResource TextMuted}" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Text="{Binding CurrentStepName}" FontSize="23" FontWeight="Bold" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="RECIPE / CYCLE" Foreground="{StaticResource TextMuted}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding RecipeCycleText}" Foreground="{StaticResource TextMuted}" FontSize="12" HorizontalAlignment="Right" TextAlignment="Right" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Background="{StaticResource Surface}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="PROCESS INSTRUMENTS" Foreground="{StaticResource TextMuted}" FontWeight="Bold" FontSize="12"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="42"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="85"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Text="Pressure" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PressureValue}" FontSize="18" FontWeight="Bold"/>
                                <ProgressBar Value="{Binding PressureProgress, Mode=OneWay}" Maximum="100"/>
                            </StackPanel>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding PressureStatus}" Foreground="{Binding PressureStatusBrush}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                            <TextBlock Grid.Row="1" Text="Temp" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TemperatureValue}" FontSize="18" FontWeight="Bold"/>
                                <ProgressBar Value="{Binding TemperatureProgress, Mode=OneWay}" Maximum="100" Foreground="{StaticResource Warning}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding TemperatureStatus}" Foreground="{Binding TemperatureStatusBrush}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                            <TextBlock Grid.Row="2" Text="Film" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FilmValue}" FontSize="18" FontWeight="Bold"/>
                                <ProgressBar Value="{Binding FilmProgress, Mode=OneWay}" Maximum="100" Foreground="{StaticResource Success}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding FilmStatus}" Foreground="{Binding FilmStatusBrush}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="4" Background="{Binding AlarmCardBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ALARM PRIORITY" Foreground="{StaticResource TextPrimary}" Opacity="0.7" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Grid.Row="1" Text="{Binding AlarmTitle}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                        <StackPanel Grid.Column="1" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AlarmDetail}" FontSize="12" TextAlignment="Right"/>
                            <TextBlock Text="{Binding AlarmCode}" Foreground="{StaticResource Warning}" FontWeight="Bold" FontSize="12" TextAlignment="Right" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="5" Background="{StaticResource Surface}" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="OPERATOR ACTION LOG" Foreground="{StaticResource TextMuted}" FontWeight="Bold" FontSize="12"/>
                        <ItemsControl ItemsSource="{Binding OperatorLog}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Foreground="{StaticResource TextMuted}" Width="58" FontSize="12"/>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Action}" Foreground="{StaticResource Warning}" Width="108" FontSize="12" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextPrimary}" FontSize="12"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Open optional Unity viewer folder"
                                Command="{Binding OpenUnityViewerCommand}"
                                Style="{StaticResource CommandButton}"
                                Margin="0,10,0,0"
                                Height="34"
                                FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="TIMELINE DEBUG TABLE — Core-generated process steps" Foreground="{StaticResource TextMuted}" FontWeight="Bold" FontSize="13"/>
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Steps}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          Background="{StaticResource Surface}"
                          Foreground="{StaticResource TextPrimary}"
                          RowBackground="#111820"
                          AlternatingRowBackground="#0F151B"
                          HorizontalGridLinesBrush="{StaticResource BorderSoft}"
                          VerticalGridLinesBrush="{StaticResource BorderSoft}"
                          GridLinesVisibility="All"
                          BorderBrush="{StaticResource Border}"
                          BorderThickness="1"
                          RowHeight="25"
                          ColumnHeaderHeight="30"
                          Margin="0,8,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="45"/>
                        <DataGridTextColumn Header="Step" Binding="{Binding Step}" Width="170"/>
                        <DataGridTextColumn Header="Cycle" Binding="{Binding Cycle}" Width="70"/>
                        <DataGridTextColumn Header="Duration ms" Binding="{Binding DurationMs}" Width="100"/>
                        <DataGridTextColumn Header="Pressure" Binding="{Binding Pressure}" Width="110"/>
                        <DataGridTextColumn Header="Temp" Binding="{Binding Temperature}" Width="80"/>
                        <DataGridTextColumn Header="Film" Binding="{Binding Film}" Width="80"/>
                        <DataGridTextColumn Header="Valve" Binding="{Binding Valve}" Width="100"/>
                        <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="80"/>
                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
